{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies":["**/.env.*local"],
  "globalEnv": ["IMPORTANT_GLOBAL_VARIABLE"],
  "tasks": {
    "build": {
      "dependsOn": ["^db:generate","^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**",".next/**", "!.next/cache/**","outputs","your-outputs-here"],
      "cache": false,
      "env": ["ACCESS_KEY_ID", "NEXT_PUBLIC_SECRET_ACCESS_KEY"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^db:generate"]
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    }
  }
}